DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chatyy
SECRET_KEY=your-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=documents

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Contact form notifications. Leave RESEND_API_KEY blank to disable sending —
# submissions are still saved to the contact_submissions table either way.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=matt.bowa04@gmail.com

# Assistant messages per tenant per calendar month. Over-limit users are
# pointed at the contact form; there is no paid tier.
MONTHLY_MESSAGE_LIMIT=100

ENVIRONMENT=development
